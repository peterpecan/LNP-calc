{
  "name": "lnp-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node preview-server.mjs",
    "build": "node build-all.mjs",
    "format": "prettier --write \"*.mjs\" \"src/**/*.js\" \"tests/**/*.mjs\" vendor-entry.js",
    "format:check": "prettier --check \"*.mjs\" \"src/**/*.js\" \"tests/**/*.mjs\" vendor-entry.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsqr": "1.4.0",
    "pngjs": "5.0.0",
    "prettier": "3.9.9"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
